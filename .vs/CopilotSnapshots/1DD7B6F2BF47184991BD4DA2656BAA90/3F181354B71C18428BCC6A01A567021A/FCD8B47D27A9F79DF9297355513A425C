using System;
using System.Collections.Generic;
using System.Text;

namespace TempConverter
{
    class Temperaturev2
    {
        private double TempInCelsius;
        private double TempInFahrenheit;
        public Temperaturev2(double T, char Unite)
        {
            Unite = char.ToUpper(Unite);
            if (Unite == 'C')
            {
                TempInCelsius = T;
                TempInFahrenheit = CtoF(T);
            }
            else
            {
                TempInFahrenheit = T;
                TempInCelsius = FtoC(T);
            }
        }
        public double GetCel()
        {
            return TempInCelsius;
        }
        public double GetFar()
        {
            return TempInFahrenheit;
        }
        // Setters that update both internal representations
        public void SetCel(double c)
        {
            TempInCelsius = c;
            TempInFahrenheit = CtoF(c);
        }

        public void SetFar(double f)
        {
            TempInFahrenheit = f;
            TempInCelsius = FtoC(f);
        }

        // Conversion helpers. Made public and static because conversions may be
        // needed in many places without creating an instance.
        public static double CtoF(double c)
        {
            return c * 9.0 / 5.0 + 32.0;
        }

        public static double FtoC(double f)
        {
            return (f - 32.0) * 5.0 / 9.0;
        }
        public bool Chauffage()
        {
            if (TempInCelsius < 15.0) return true;
            else return false;
        }
    }

}
