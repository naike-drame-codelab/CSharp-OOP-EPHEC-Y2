using System;
using System.Collections.Generic;
using System.Text;

namespace DiceMaker
{
    class De
    {
        public int valeur;
        public int nbFaces = 6;

        public De (int nbFaces)
        {
            this.nbFaces = nbFaces;
        }

        public int Lancer()
        {
            Random random = new Random();
            int roll = random.Next(1, nbFaces + 1);
            valeur = roll;
            return valeur;
        }

        public int Lire()
        {
            return valeur;
        }
    }
}
